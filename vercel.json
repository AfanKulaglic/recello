{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/verify",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/verify.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/docs/verification",
      "destination": "/docs/getting-started",
